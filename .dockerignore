# VCS
.git
**/.git

# Editor
.vscode
**/.vscode

# Dependencies and build output. The ** forms are load-bearing: a bare pattern
# matches only the root copy, and cli/app/node_modules alone is hundreds of
# gigabytes, all of which was being sent to the daemon as build context.
node_modules
**/node_modules
.next
**/.next
out
build
dist
coverage

# Runtime data and logs
data
logs

# Local env files (inject at runtime via --env-file or -e)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
